{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*blockpop.*)\\.vercel\\.app"
        }
      ],
      "destination": "/jogo.html"
    },
    {
      "source": "/3d/:slug",
      "destination": "/tour3d.html"
    },
    {
      "source": "/corrida/:slug",
      "destination": "/corrida.html"
    },
    {
      "source": "/resgate",
      "destination": "/resgate.html"
    },
    {
      "source": "/jogo",
      "destination": "/jogo.html"
    },
    {
      "source": "/montagem/:slug",
      "destination": "/montagem.html"
    },
    {
      "source": "/media/:path*",
      "destination": "https://rrlxhnmfsmknzhqpfrhr.supabase.co/storage/v1/object/public/media/:path*"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/landing?slug=:slug"
    },
    {
      "source": "/r/:token",
      "destination": "/api/landing?report=:token"
    },
    {
      "source": "/inicio",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing?home=1"
    },
    {
      "source": "/((?!p/|api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing"
    },
    {
      "source": "/((?!api/|media/).*)",
      "missing": [
        {
          "type": "host",
          "value": "(.*\\.vercel\\.app|localhost.*|127\\.0\\.0\\.1.*|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/3d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/corrida/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/montagem/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tour3d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!crazygames/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/jogo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/jogo.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/resgate",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/resgate.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/crazygames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/inicio",
      "permanent": false
    }
  ]
}
