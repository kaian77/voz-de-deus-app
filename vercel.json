{
  "rewrites": [
    {
      "source": "/bebe/",
      "destination": "/bebe.html"
    },
    {
      "source": "/3d/:slug",
      "destination": "/tour3d.html"
    },
    {
      "source": "/corrida/:slug",
      "destination": "/corrida.html"
    },
    {
      "source": "/resgate",
      "destination": "/resgate.html"
    },
    {
      "source": "/jogo",
      "destination": "/jogo.html"
    },
    {
      "source": "/treino",
      "destination": "/treino.html"
    },
    {
      "source": "/montagem/:slug",
      "destination": "/montagem.html"
    },
    {
      "source": "/coracao/:slug",
      "destination": "/coracao.html"
    },
    {
      "source": "/predio/:slug",
      "destination": "/predio.html"
    },
    {
      "source": "/media/:path*",
      "destination": "https://rrlxhnmfsmknzhqpfrhr.supabase.co/storage/v1/object/public/media/:path*"
    },
    {
      "source": "/bio/nutrimarinagusmao",
      "destination": "/bio/nutrimarinagusmao/index.html"
    },
    {
      "source": "/arenafight",
      "destination": "/arenafight.html"
    },
    {
      "source": "/drtino",
      "destination": "/drtino/index.html"
    },
    {
      "source": "/implante/:slug",
      "destination": "/implante.html"
    },
    {
      "source": "/ofs",
      "destination": "/ofs.html"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/landing?slug=:slug"
    },
    {
      "source": "/r/:token",
      "destination": "/api/landing?report=:token"
    },
    {
      "source": "/agendar/:slug",
      "destination": "/api/landing?agendar=:slug"
    },
    {
      "source": "/entrar",
      "destination": "/api/landing?entrar=1"
    },
    {
      "source": "/confirmar/:token",
      "destination": "/api/landing?confirmar=:token"
    },
    {
      "source": "/inicio",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing?home=1"
    },
    {
      "source": "/((?!p/|api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing"
    },
    {
      "source": "/((?!api/|media/).*)",
      "missing": [
        {
          "type": "host",
          "value": "(.*\\.vercel\\.app|localhost.*|127\\.0\\.0\\.1.*|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/api/landing"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/3d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/corrida/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/montagem/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/predio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/implante/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/coracao/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/tour3d/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!crazygames/|treino|bebe).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/jogo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/jogo.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/treino(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/resgate",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/resgate.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/crazygames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/bebe(/|.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bebe",
      "destination": "/bebe/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(paginaspro\\.vercel\\.app|(www\\.)?paginaspro\\.app\\.br)"
        }
      ],
      "destination": "/inicio",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*blockpop.*)\\.vercel\\.app"
        }
      ],
      "destination": "/jogo",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?ofsobradinho\\.com\\.br"
        }
      ],
      "destination": "/ofs",
      "permanent": false
    }
  ]
}
